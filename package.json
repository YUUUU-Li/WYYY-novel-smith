{
  "name": "novel-studio",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "吾又一言 — 长篇小说设定构思工作台",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/launch.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:vite": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "icons": "node scripts/make-icons.mjs && node scripts/sync-web-icons.mjs",
    "icons:web": "node scripts/sync-web-icons.mjs",
    "icons:from": "tauri icon",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:map": "node scripts/verify-map.mjs",
    "verify:org": "node scripts/verify-org.mjs",
    "verify:fuzz": "node scripts/verify-drag-fuzz.mjs",
    "verify:layout": "node scripts/measure-layout.mjs",
    "verify:terms": "node scripts/verify-terms.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "test": "npm run test:roundtrip && npm run test:watch && npm run test:search && npm run test:presence && npm run test:places && npm run test:org && npm run test:board && npm run test:save && npm run test:format && npm run test:canvas && npm run test:calendar && npm run test:terms",
    "test:roundtrip": "rolldown scripts/roundtrip-test.ts --format esm --platform node --file .test-bundle.mjs && node .test-bundle.mjs",
    "test:watch": "rolldown scripts/disk-watch-test.ts --format esm --platform node --file .watch-bundle.mjs && node .watch-bundle.mjs",
    "test:search": "rolldown scripts/search-test.ts --format esm --platform node --file .search-bundle.mjs && node .search-bundle.mjs",
    "test:presence": "rolldown scripts/presence-test.ts --format esm --platform node --file .presence-bundle.mjs && node .presence-bundle.mjs",
    "test:places": "rolldown scripts/places-test.ts --format esm --platform node --file .places-bundle.mjs && node .places-bundle.mjs",
    "test:org": "rolldown scripts/org-test.ts --format esm --platform node --file .org-bundle.mjs && node .org-bundle.mjs",
    "test:board": "rolldown scripts/board-test.ts --format esm --platform node --file .board-bundle.mjs && node .board-bundle.mjs",
    "test:save": "rolldown scripts/save-status-test.ts --format esm --platform node --file .save-bundle.mjs && node .save-bundle.mjs",
    "test:format": "rolldown scripts/disk-format-test.ts --format esm --platform node --file .format-bundle.mjs && node .format-bundle.mjs",
    "test:canvas": "rolldown scripts/canvas-graph-test.ts --format esm --platform node --file .canvas-bundle.mjs && node .canvas-bundle.mjs",
    "test:calendar": "rolldown scripts/calendar-test.ts --format esm --platform node --file .cal-bundle.mjs && node .cal-bundle.mjs",
    "test:terms": "rolldown scripts/terms-merge-test.ts --format esm --platform node --file .terms-bundle.mjs && node .terms-bundle.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.0",
    "@uiw/react-codemirror": "^4.25.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
