node_modules/
dist/

# 测试打包产物（npm test 会生成，每个套件一个）
.test-bundle.mjs
.watch-bundle.mjs
.search-bundle.mjs
.mentions-bundle.mjs
.presence-bundle.mjs
.stays-bundle.mjs
.save-bundle.mjs
.format-bundle.mjs
.canvas-bundle.mjs
.cal-bundle.mjs
.board-bundle.mjs
.org-bundle.mjs
